cmake_minimum_required(VERSION 3.24)
file(GLOB_RECURSE headers "${CMAKE_CURRENT_LIST_DIR}/../include/*.h")
file(GLOB_RECURSE sources "${CMAKE_CURRENT_LIST_DIR}/../src/*.cpp")
set(classes 0)
set(fields 0)
set(behaviors 0)
set(exceptions 0)
set(associations 0)
set(names "")
foreach(header IN LISTS headers)
  file(READ "${header}" text)
  string(REGEX MATCHALL "class [A-Za-z_]+[ \n]*[:{]" definitions "${text}")
  list(LENGTH definitions count)
  if(NOT count EQUAL 1)
    message(FATAL_ERROR "Expected one class in ${header}")
  endif()
  math(EXPR classes "${classes}+1")
  get_filename_component(name "${header}" NAME_WE)
  list(APPEND names "${name}")
  if(text MATCHES "public std::runtime_error")
    math(EXPR exceptions "${exceptions}+1")
  endif()
  string(REGEX MATCH "private:[^}]*" private_fields "${text}")
  string(REGEX MATCHALL "[a-z]+[a-z_]*_" members "${private_fields}")
  list(LENGTH members count)
  math(EXPR fields "${fields}+${count}")
endforeach()
foreach(header IN LISTS headers)
  file(READ "${header}" text)
  get_filename_component(owner "${header}" NAME_WE)
  string(REGEX REPLACE "\"[^\"]*\"" "" text "${text}")
  string(REGEX MATCH "private:[^}]*" private_fields "${text}")
  string(REGEX MATCHALL "\n  [^\n()]+\\([^()]*\\)( const)?;" declarations "${text}")
  string(REGEX MATCHALL "\\([^()]*\\)" parameters "${declarations}")
  foreach(name IN LISTS names)
    if(NOT name STREQUAL owner AND "${private_fields};${parameters}" MATCHES "(^|[^A-Za-z])${name}([^A-Za-z]|$)")
      math(EXPR associations "${associations}+1")
    endif()
  endforeach()
endforeach()
foreach(source IN LISTS sources)
  file(READ "${source}" text)
  string(REGEX MATCHALL "\n[A-Za-z][^\n]* [A-Za-z]+::[A-Za-z]+\\(" methods "${text}")
  foreach(method IN LISTS methods)
    if(NOT method MATCHES "::(Resume|StopSales|RequireAllergenFree|EndShift|ReadPart)\\(")
      math(EXPR behaviors "${behaviors}+1")
    endif()
  endforeach()
endforeach()
math(EXPR domain_classes "${classes}-${exceptions}")
message(STATUS "Non-exception classes=${domain_classes}; total classes=${classes}; own fields=${fields}; behaviors=${behaviors}; associations=${associations}; exceptions=${exceptions}")
if(domain_classes LESS 50 OR fields LESS 150 OR behaviors LESS 100 OR associations LESS 30 OR exceptions LESS 12)
  message(FATAL_ERROR "The domain model does not meet lab 2 requirements")
endif()
